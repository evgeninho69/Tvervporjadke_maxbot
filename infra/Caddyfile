tver4ever.ru {
  encode zstd gzip

  @max_webhook path /integrations/max/webhook /integrations/max/webhook/*
  @mini_api path /v1/* /admin/v1/* /v2/* /admin/v2/* /internal/v2/*
  @miniapp_root path /max-miniapp
  @miniapp_test_root path /max-miniapp-test
  @miniapp_test path /max-miniapp-test/ /max-miniapp-test/*
  @health path /healthz

  handle @max_webhook {
    reverse_proxy max-bot-service:8090
  }

  handle @mini_api {
    reverse_proxy core-api:8088
  }

  handle @miniapp_root {
    redir /max-miniapp/ 302
  }

  handle_path /max-miniapp/* {
    reverse_proxy max-miniapp:8080
  }

  handle @miniapp_test_root {
    redir /max-miniapp-test/ 302
  }

  handle @miniapp_test {
    uri strip_prefix /max-miniapp-test
    reverse_proxy max-miniapp:8080
  }

  handle @health {
    reverse_proxy max-bot-service:8090
  }

  handle {
    redir /max-miniapp/ 302
  }
}
