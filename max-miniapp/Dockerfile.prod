FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY tsconfig.json vite.config.ts index.html ./
COPY public ./public
COPY src ./src
ARG VITE_API_BASE_URL
ARG VITE_ACTIVE_TVER_BEARER_TOKEN
ARG VITE_CHANNEL_HANDLE
ARG VITE_CHANNEL_NAME
ARG VITE_BASE_PATH
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_ACTIVE_TVER_BEARER_TOKEN=$VITE_ACTIVE_TVER_BEARER_TOKEN
ENV VITE_CHANNEL_HANDLE=$VITE_CHANNEL_HANDLE
ENV VITE_CHANNEL_NAME=$VITE_CHANNEL_NAME
ENV VITE_BASE_PATH=$VITE_BASE_PATH
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
