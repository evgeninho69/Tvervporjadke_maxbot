COMPOSE_PROJECT_NAME=active-tver

DOCKER_HOST=ssh://user@ip

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_DOMAIN=localhost.com
# Time in milliseconds
BACKEND_READ_TIMEOUT=250ms
BACKEND_READ_HEADER_TIMEOUT=250ms
# Time in seconds
BACKEND_WRITE_TIMEOUT=1s
# Time in minutes
BACKEND_IDLE_TIMEOUT=30m

TLS_CERTIFICATE=path/your_crt_name.crt
TSL_KEY=path/your_key_name.crt

STORAGE_HOST=127.0.0.1
STORAGE_PORT=5432
STORAGE_NAME=storage_name
STORAGE_USER=storage_user
STORAGE_PASSWORD=user_pwd

TOKENS_JWT_SECRET_KEY=default
# Time in minutes
TOKENS_JWT_DURATION=15m
TOKENS_REFRESH_LENGTH=64m
# Time in hours
TOKENS_REFRESH_DURATION=30h
TOKENS_SECRET_KEY=default

EMAIL_HOST=default
EMAIL_PORT=465
EMAIL_SENDER=default@default.com
EMAIL_PASSWORD=default
EMAIL_SUPPORT=support@default.com

PGADMIN_DEFAULT_EMAIL=your_email
PGADMIN_DEFAULT_PASSWORD=your_pga_pwd
PGADMIN_CONFIG_SERVER_MODE=False
PGADMIN_PORT=port:port

OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_CONSOLE_PORT=9001
OBJECT_STORAGE_ACCESS_KEY_ID=keyID
OBJECT_STORAGE_SECRET_ACCESS_KEY=secret_key
OBJECT_STORAGE_SESSION_TOKEN=token
OBJECT_STORAGE_ENDPOINT=at-object-storage:9000
OBJECT_STORAGE_BUCKET=videos
OBJECT_STORAGE_ACCESS_HOST=127.0.0.1:8000
